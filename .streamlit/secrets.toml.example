# 로컬: 이 파일을 .streamlit/secrets.toml 로 복사해 값을 채운다 (.gitignore에 포함되어 커밋되지 않음)
# 배포: Streamlit Community Cloud → 앱 Settings → Secrets 에 같은 내용을 붙여 넣는다
# 최상위 키는 환경 변수로 옮겨져 redpen 패키지가 읽는다 (app.py의 _secrets_to_env)

# ── LLM 모드 (선택) ── 비워 두면 규칙 기반으로 동작
# REDPEN_LLM_PROVIDER = "anthropic"          # anthropic | openai | openai_compatible
# REDPEN_LLM_API_KEY = "여기에-키"
# REDPEN_LLM_MODEL = "claude-sonnet-5-5"      # 판정·검증·수정 문안
# REDPEN_LLM_MODEL_FAST = "claude-haiku-5-5"  # 주장 추출·근거 분류
# REDPEN_LLM_BASE_URL = ""                   # openai_compatible(사내 모델)일 때만
# REDPEN_LLM_MAX_CALLS = "1000"              # 프로세스당 누적 호출 상한
# REDPEN_LLM_PASSCODE = "공개-데모용-접근코드"  # 설정하면 코드를 입력한 사람만 LLM 모드 사용

# ── SEC EDGAR 실시간 (선택) ── SEC 공정 접근 정책: 이름·연락처 명시
# SEC_USER_AGENT = "MONDAI RedPen 팀연락처@example.com"
